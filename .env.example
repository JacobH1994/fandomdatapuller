# Copy to .env and fill in real values. Never commit .env.
# Get these from dev.twitch.tv (a registered application, client-credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# etl/generate_tournament_aliases.py — one LLM call per tournament series
# for colloquial nicknames (console.anthropic.com). Optional: unset means
# that script writes rule-based aliases only and skips the LLM step.
ANTHROPIC_API_KEY=

# collectors/youtube_poll.py (PRD §9.7) — plain API key against a Google
# Cloud project (console.cloud.google.com), enable "YouTube Data API v3",
# no OAuth needed for public reads. Required to run that collector at
# all (unlike ANTHROPIC_API_KEY, there's no degraded no-op mode — it
# exits with an error if unset, matching TWITCH_CLIENT_ID/SECRET above).
YOUTUBE_API_KEY=

# collectors/steam_poll.py (PRD §9.12) — free API key, register at
# https://steamcommunity.com/dev/apikey. Required to run that collector
# at all (same "no degraded mode" reasoning as YOUTUBE_API_KEY above) —
# and confirmed live that several high-traffic titles (CS2, PUBG, Apex,
# Tekken) silently return player_count=0 without a key present, not an
# error, so this isn't optional-but-recommended, it's load-bearing for
# correctness.
STEAM_API_KEY=
