# Secrets
.env

# Confidential external documents (third-party pricing decks, WIP pitch
# decks) — never for this repo, regardless of what gets dropped in here.
docs/Other/

# Databases (derived and disposable — rebuilt from data/raw/, see CLAUDE.md)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db.lock

# Connector caches (disposable, re-fetchable — not the permanent raw record)
data/cache/

# Kaggle historical import source file(s) — a stably-hosted external
# dataset, re-downloadable anytime (unlike data/raw/twitch/, which can
# never be recreated). See collectors/kaggle_import.py.
data/kaggle/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Local run logs (e.g. scripts/lpdb_overnight_sync.py) -- disposable, not a permanent record
logs/

# OS
.DS_Store

# Editor swap/lock files
*.swp
.*.kate-swp
